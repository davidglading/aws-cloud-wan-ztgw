# Example values for AWS Cloud WAN ZTGW deployment
# Copy this file to terraform.tfvars and update the values for your environment.

# Set to true to deploy in aws_region and secondary_aws_region.
# Set to false for a single-region deployment.
multiregion_deployment = false

aws_region = "us-west-1"
# Used only for multi-region deployments; must differ from aws_region.
secondary_aws_region = "us-west-1"

# Naming prefix used in VPC and resource names (example from the deployment guide)
naming_prefix = "dglading-cloud-wan"

# AWS interface endpoint service name prefix for the SSM private endpoints
# Example values: "com.amazonaws" or a custom/private endpoint namespace if applicable
vpc_endpoint_service_name = "com.amazonaws"

# Optional suffix overrides. Blank uses the region name, or 1/2 for us-east-1/2.
region_suffix            = ""
secondary_region_suffix = ""

# Add ec2messages only in regions that support the legacy endpoint.
ssm_endpoint_services   = ["ssm", "ssmmessages"]

# Zscaler must authorize this AWS account for each regional GWLB service.
# Each key must match a deployed region. Regions omitted from this map have
# inspection endpoints/routes pending. Never use the dummy service IDs below.
ztgw_endpoint_service_names = {}
# ztgw_endpoint_service_names = {
#   "us-east-1" = "com.amazonaws.vpce.us-east-1.vpce-svc-nnnnnnnnnnnnnnnnn"
#   "us-east-2" = "com.amazonaws.vpce.us-east-2.vpce-svc-nnnnnnnnnnnnnnnnn"
# }

# Optional ZPA DNS forwarding, keyed by an active <region>-prod or <region>-dev
# VPC. VPC IDs and both workload subnet IDs are derived automatically.
# Empty means no Route 53 Resolver resources or endpoint charges.
zpa_dns = {}
# zpa_dns = {
#   "us-west-1-prod" = {
#     application_domain_names = ["apps.example.internal", "private.example.com"]
#     target_ips               = ["185.46.212.88", "185.46.212.89"]
#     target_port              = 53
#     zscaler_cloud_name       = "zscaler.net"
#     zpa_cloud_name           = "ZPA" # or ZPA-Beta
#     additional_system_domains = []
#   }
# }
